#: data/ScreenshotWlApplet.desktop.in:4 src/Applet.vala:38 src/Capture.vala:353
#: src/Capture.vala:405 src/Capture.vala:417
msgid "Screenshot"
msgstr "Captura de pantalla"

#: data/ScreenshotWlApplet.desktop.in:5
msgid ""
"Capture a monitor, a window or a selection; copy to the clipboard and/or "
"save, with a history of recent shots."
msgstr ""
"Captura un monitor, una ventana o una selección; copia al portapapeles y/o "
"guarda, con un historial de capturas recientes."

#: data/io.github.budgiescreenshotwl.gschema.xml:7
msgid "Delay in seconds before the capture"
msgstr "Retardo en segundos antes de la captura"

#: data/io.github.budgiescreenshotwl.gschema.xml:11
msgid "Include the mouse pointer"
msgstr "Incluir el puntero del ratón"

#: data/io.github.budgiescreenshotwl.gschema.xml:15
msgid ""
"Save screenshots to disk (when off they are only copied to the clipboard)"
msgstr ""
"Guardar las capturas en el disco (si está desactivado, solo se copian al "
"portapapeles)"

#: data/io.github.budgiescreenshotwl.gschema.xml:19
msgid "Show the recent screenshots section in the popover"
msgstr "Mostrar la sección de capturas recientes en el applet"

#: data/io.github.budgiescreenshotwl.gschema.xml:23
msgid "Whether the recent screenshots section is expanded"
msgstr "Si la sección de capturas recientes está desplegada"

#: data/io.github.budgiescreenshotwl.gschema.xml:27
msgid "Show a random face in the panel when a screenshot is taken"
msgstr "Mostrar una cara aleatoria en el panel al hacer una captura"

#: data/io.github.budgiescreenshotwl.gschema.xml:35
msgid "Mode button icons: classic (old applet) or budgie (Budgie Screenshot)"
msgstr ""
"Iconos de los botones: classic (applet antiguo) o budgie (Budgie Screenshot)"

#: data/io.github.budgiescreenshotwl.gschema.xml:39
msgid "Flash the screen when a screenshot is taken"
msgstr "Hacer un destello en la pantalla al hacer una captura"

#: data/io.github.budgiescreenshotwl.gschema.xml:43
msgid "Folder to save screenshots in (empty = ~/Pictures/Screenshots)"
msgstr ""
"Carpeta para guardar las capturas (vacío = Imágenes/Screenshots en la "
"carpeta personal)"

#: data/io.github.budgiescreenshotwl.gschema.xml:47
msgid "Copy every screenshot to the clipboard (needs wl-copy)"
msgstr "Copiar cada captura al portapapeles (requiere wl-copy)"

#: data/io.github.budgiescreenshotwl.gschema.xml:51
msgid "Show a notification after taking a screenshot"
msgstr "Mostrar una notificación después de hacer una captura"

#: data/io.github.budgiescreenshotwl.gschema.xml:55
msgid "Play the camera shutter sound (needs canberra-gtk-play)"
msgstr "Reproducir el sonido del obturador (requiere canberra-gtk-play)"

#: data/io.github.budgiescreenshotwl.gschema.xml:59
msgid "Re-open the applet after taking a screenshot"
msgstr "Volver a abrir el applet después de hacer una captura"

#: data/io.github.budgiescreenshotwl.gschema.xml:63
msgid "Show thumbnails in the history list"
msgstr "Mostrar miniaturas en el historial"

#: data/io.github.budgiescreenshotwl.gschema.xml:68
msgid "Number of recent screenshots to remember"
msgstr "Número de capturas recientes que recordar"

#: data/io.github.budgiescreenshotwl.gschema.xml:72
msgid "Recent screenshot paths (newest first)"
msgstr "Rutas de las capturas recientes (la más nueva primero)"

#: data/io.github.budgiescreenshotwl.gschema.xml:76
msgid ""
"Editor command for the Edit button, %f is the file (empty = no Edit button)"
msgstr ""
"Comando del editor para el botón Editar, %f es el archivo (vacío = sin botón "
"Editar)"

#: data/io.github.budgiescreenshotwl.gschema.xml:79
msgid "\"Screenshot from %Y-%m-%d %H-%M-%S\""
msgstr "\"Captura de pantalla de %Y-%m-%d %H-%M-%S\""

#: data/io.github.budgiescreenshotwl.gschema.xml:80
msgid "strftime-style file name (without extension)"
msgstr "Nombre de archivo en formato strftime (sin extensión)"

#: src/Capture.vala:166
msgid "wl-copy not found (install wl-clipboard)"
msgstr "No se encontró wl-copy (instale wl-clipboard)"

#: src/Capture.vala:217 src/Capture.vala:247
#, c-format
msgid "%s not found"
msgstr "No se encontró %s"

#: src/Capture.vala:223
msgid "Your grim is too old for window capture (needs 1.5+)"
msgstr ""
"Su versión de grim es demasiado antigua para capturar ventanas (se necesita "
"1.5+)"

#: src/Capture.vala:229
msgid "Your compositor doesn't support capturing single windows"
msgstr "Su compositor no permite capturar ventanas individuales"

#: src/Capture.vala:294
#, c-format
msgid "grim failed: %s"
msgstr "grim falló: %s"

#: src/Capture.vala:348
#, c-format
msgid "Cannot create %s"
msgstr "No se puede crear %s"

