msgid "%s not found"
msgstr "%s nicht gefunden"

#: src/Capture.vala:201
msgid "Your grim is too old for window capture (needs 1.5+)"
msgstr "Ihre grim-Version ist zu alt für Fensteraufnahmen (1.5+ benötigt)"

#: src/Capture.vala:207
msgid "Your compositor doesn't support capturing single windows"
msgstr "Ihr Compositor unterstützt keine Aufnahmen einzelner Fenster"

#: src/Capture.vala:272
#, c-format
msgid "grim failed: %s"
msgstr "grim fehlgeschlagen: %s"

#: src/Capture.vala:326
#, c-format
msgid "Cannot create %s"
msgstr "%s kann nicht erstellt werden"

